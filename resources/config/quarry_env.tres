[gd_resource type="Environment" load_steps=3 format=3 uid="uid://cq2gubquarryenv"]

; Environment for Twin Quarry. Overcast first light at the bottom of a stone
; pit, and the one weather on the map list: Rust is a hard afternoon, Kopje
; Crossing a noon, Lantern Wharf a dusk, Halcyon Wake a bright morning and
; Whisperbloom Hollow a torch-lit night. None of them is grey (D-058).
;
; Derived from `wharf_env.tres`, which came from `safari_env.tres`, which came
; from `rust_env.tres`, and the rule held again: the tonemapping, the glow and
; the SSAO are theirs, and the sky, the fog and the exposure are the whole of
; the difference.
;
;   * A flat sky: pale blue-grey overhead, a colder white at the horizon, with
;     the sun's disc curve wide so nothing on it reads as a sun. It is the
;     ambient and the reflections, so every face of every block gets light and
;     the map's shape comes from SSAO and from the drill lines rather than from
;     shadow — which is the point of an overcast, and why the two work lamps
;     over the bases are the only warm thing in the pit.
;   * **`background_energy_multiplier` is the exposure control** (see
;     `rust_env.tres`, which measured it). 1.05 here, which is the lowest on any
;     map: a flat sky is ambient from every direction at once, and pale stone
;     under it at the wharf's 1.5 came out white with no readable edges at all.
;   * Fog is height-limited so it lies *in* the pit rather than over it: the
;     floor at y = 0 is hazier than the rim at 11 m, which is what separates the
;     near cover from the far cover on a map whose stone is all one rock.
;     **It has to be thin.** The first pass ran the height density at 0.12 and
;     the bottom eleven metres of the pit — which is all of the map anybody
;     plays in — came out as a flat white field with the cover invisible in it.
;     0.02 is a haze you read depth from; anything near a tenth is weather.
;   * Glow stays on at Rust's threshold, for the two lamp heads.

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_quarrysky"]
sky_top_color = Color(0.42, 0.49, 0.59, 1)
sky_horizon_color = Color(0.7, 0.73, 0.77, 1)
sky_curve = 0.42
sky_energy_multiplier = 1.0
ground_bottom_color = Color(0.3, 0.29, 0.27, 1)
ground_horizon_color = Color(0.6, 0.59, 0.56, 1)
ground_curve = 0.1
ground_energy_multiplier = 1.0
sun_angle_max = 40.0
sun_curve = 0.02
use_debanding = true

[sub_resource type="Sky" id="Sky_quarry"]
sky_material = SubResource("ProceduralSkyMaterial_quarrysky")
radiance_size = 3

