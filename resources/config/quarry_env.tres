[gd_resource type="Environment" load_steps=3 format=3 uid="uid://cq2gubquarryenv"]

; Environment for Twin Quarry. **Hard sun, late morning, no cloud** — the
; weather a worked-out limestone pit is remembered in, and a deliberate change
; at the rebuild (D-138): this map shipped under an overcast, which made it the
; one grey map on the list and made a pit full of one rock read as one material
; lit four ways. The owner's brief for the rebuild says sun-baked, and a
; sun-baked quarry is a *shadow* map — the floor is pale, the faces are sawn,
; and everything the player needs to read about the shape of the place is
; written by the sun on those faces.
;
; It is still not Kopje Crossing's noon or Rust's afternoon: the sun here is
; 50 degrees up out of the north-east and the sky has nothing in it, so the
; shadows are hard, short and coloured by bounce off pale stone rather than by
; a sky.
;
;   * A clear sky: deep blue overhead going to a dusty, almost white horizon,
;     with the disc curve tight so the sun reads as a sun. It is the ambient
;     and the reflections both, and the bounce off a limestone floor is what
;     fills the shaded side of every block — which is why the ground colours
;     below are warm and light rather than the neutral dark the other maps use.
;   * **`background_energy_multiplier` is the exposure control** (see
;     `rust_env.tres`, which measured it). 1.3: higher than the overcast's 1.05
;     because a clear sky puts far less ambient into a pit than a flat white
;     one does, and the stone went muddy at the old number.
;   * Fog is height-limited so it lies *in* the pit rather than over it, and it
;     is warm now rather than blue-grey: dust over hot rock, not sea air.
;     **It has to be thin** — the first overcast pass ran it at 0.12 and the
;     bottom eleven metres came out a flat white field with the cover invisible
;     in it. 0.016 is a haze you read depth from.
;   * **Volumetric fog is on**, which it was not, and `quarry_ambience.gd` is
;     why: the heat haze over the floor and the dust hanging in the shaft are
;     both `FogVolume`s, and a `FogVolume` in a scene with volumetric fog
;     disabled draws nothing at all and reports nothing about it.
;   * Glow stays on at Rust's threshold, for the two lamp heads and the sun.

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_quarrysky"]
sky_top_color = Color(0.19, 0.36, 0.62, 1)
sky_horizon_color = Color(0.79, 0.79, 0.74, 1)
sky_curve = 0.15
sky_energy_multiplier = 1.0
ground_bottom_color = Color(0.45, 0.41, 0.34, 1)
ground_horizon_color = Color(0.72, 0.68, 0.59, 1)
ground_curve = 0.1
ground_energy_multiplier = 1.0
sun_angle_max = 8.0
sun_curve = 0.12
use_debanding = true

[sub_resource type="Sky" id="Sky_quarry"]
sky_material = SubResource("ProceduralSkyMaterial_quarrysky")
radiance_size = 3

