[gd_resource type="Environment" load_steps=2 format=3 uid="uid://cq2gubrangeenv"]

; Environment for Glowworm Grounds. It was the Hollow's own night (D-113); it is
; now the hour before it, and that is the whole of what this file is about.
;
; The night was defensible, it was measured, and it lost. The argument for it
; was that the range is a corner of the Hollow's world and a different sky over
; it would say it was somewhere else. The argument against it is what a range is
; *for*: you go there to read a target at forty-five metres and to see where
; your spear landed, and at 11 degrees of moon the peat, the timber and the
; distance posts were one dark mass with lantern heads floating in it. The fix
; at the time was to push the fill until the ground existed — moon 1.15, sky
; ambient 8.0, peat albedo 0.235 — which is three numbers all saying the same
; thing, namely that the light was wrong rather than too low.
;
; So it is an hour earlier and the same bog: **a nine-degree sun north-north-east
; and a sky full of cumulus** (`range_sky.tres`). The lanterns and the torches
; stay lit, because this is the hour they come on and the hour they read best;
; they are simply no longer the only light on the map.
;
; Every number below was set against the ten `preview_map` renders — `top`,
; `side` and the eight pads at eye height — read back as a histogram, in
; `rust_env.tres`'s tradition. The frames are in `tools/showroom/out/range_sunset/`.
;
;   * **ALL ambient still comes from the sky** (`ambient_light_source = 3`,
;     contribution 1.0), and it is now doing real work rather than standing in
;     for a light. **0.62, not 8.0.** That is not a taste change: 8.0 was a
;     multiplier on a night sky whose radiance cubemap averages near-black, and
;     the same 8.0 over an apricot skyline is eight times a real number. At 1.05
;     the whole bog came out one pale mauve sheet with no shaded face left on it;
;     0.62 with the Sun at 4.2 puts the peat at the far end of the bow lane
;     (45 m) at a median of 82-126 of 255 across the front four pads, mean RGB
;     186/122/72 — warm, not grey — while the apron at 8 m sits at 29-37 with a
;     tenth percentile of 26, so it is dark and not crushed. None of pads 0-3
;     crushes a single pixel and none clips more than 0.01%.
;     A grazing key lands sin(9 deg) = 15.6% of itself on a horizontal surface
;     and this entire map is horizontal surface, so the ambient is still most of
;     what the peat is lit by, exactly as it was at night. The difference is
;     that what it is derived from now has colour in it.
;   * **Volumetric fog 0.0035, down from 0.010.** Thinner because there is more
;     light in the air to pick it up: at 0.010 under this sky the map came back
;     as a milky wash with the far half of the bow lane inside it, and the first
;     pass at 0.006 with the Sun's `light_volumetric_fog_energy` at 1.0 was worse
;     — every render, the top-down one included, was veiled. That knob is back
;     at 0.25 in `range.tscn`. `volumetric_fog_anisotropy` is **0.6 rather than
;     0.4**, which is the one number here that is purely about the hour:
;     strongly forward-scattering fog under a sun nine degrees up is what puts
;     light *along* the ground toward the north-north-east.
;   * **Height fog: 0.9 m at 0.015, down from 1.2 m at 0.10.** This is the
;     single biggest correction in the file and it was invisible at night. A
;     dense layer in the bottom metre under a cold moon is a hint of damp; the
;     same layer under a warm sky is a **lit** sheet, and a standing Bog's eyes
;     at 1.33 m look along sixty metres of it. The first sunset render had the
;     whole bog as a featureless pale plain with the lane rails inside it, and
;     the tell was that the lodge deck at exactly 1.2 m — the old `fog_height` —
;     was the only clean surface in frame. `range_ambience.gd`'s own `FogVolume`
;     came down from 0.020 to 0.012 and went warm for the same reason.
;   * Distance fog **0.0014** with `fog_aerial_perspective` 0.22, both about half
;     the night's, and `fog_sun_scatter` **0.22 rather than 0.05**. Scatter is
;     nearly worthless with a moon behind you and is most of the picture with a
;     9-degree sun ahead-right of you.
;   * **Glow threshold 2.4, not 1.45.** 1.45 was above a moonlit Bog and below a
;     torch flame. Under this sky it is below the *sky*: every cloud top and the
;     whole skyline crossed it and the frame came back hazed. 2.4 is above the
;     brightest cloud and below the sun disc, the torch flames and the lantern
;     heads, which are the three things on this map that are meant to bloom.
;     `glow_intensity` 0.7 with it.
;   * SSAO is the island's at **1.7 rather than 2.2 intensity**. On a map of flat
;     slabs it is most of what makes a 1.25 m block read as a block from twenty
;     metres, and a low sun makes it matter more, not less — but at 2.2 it was
;     taking the unlit underside of the lodge roof to literal zero over the eight
;     spawn pads. See `range.tscn`'s `Bounce` for the other half of that fix.
;   * `adjustment_saturation` back to 1.0 from 1.1. The night needed a push; a
;     sunset sky through an ACES tonemap does not, and at 1.1 the peat went
;     magenta.
;   * No SSR. Peat reflects nothing, and a screen-space pass over a map this long
;     is a cost with no image behind it.

[ext_resource type="Sky" path="res://resources/config/range_sky.tres" id="1_range_sky"]

[resource]
resource_name = "GlowwormGroundsEnvironment"
background_mode = 2
sky = ExtResource("1_range_sky")
background_energy_multiplier = 1.0
ambient_light_source = 3
ambient_light_color = Color(0.62, 0.48, 0.45, 1)
ambient_light_sky_contribution = 1.0
ambient_light_energy = 0.62
reflected_light_source = 2
tonemap_mode = 3
tonemap_exposure = 1.0
tonemap_white = 6.0
ssao_enabled = true
ssao_radius = 1.2
ssao_intensity = 1.7
ssao_power = 1.4
ssao_detail = 0.6
ssao_horizon = 0.08
ssao_sharpness = 0.98
ssao_light_affect = 0.15
ssao_ao_channel_affect = 0.35
glow_enabled = true
glow_levels/1 = 0.0
glow_levels/2 = 0.35
glow_levels/3 = 0.85
glow_levels/4 = 1.0
glow_levels/5 = 0.7
glow_levels/6 = 0.25
glow_levels/7 = 0.0
glow_normalized = true
glow_intensity = 0.7
glow_strength = 1.0
glow_mix = 0.05
glow_bloom = 0.0
glow_blend_mode = 1
glow_hdr_threshold = 2.4
glow_hdr_scale = 2.0
glow_hdr_luminance_cap = 10.0
fog_enabled = true
fog_light_color = Color(0.48, 0.34, 0.28, 1)
fog_light_energy = 0.7
fog_sun_scatter = 0.22
fog_density = 0.0014
fog_aerial_perspective = 0.22
fog_sky_affect = 0.06
fog_height = 0.9
fog_height_density = 0.015
volumetric_fog_enabled = true
volumetric_fog_density = 0.0035
volumetric_fog_albedo = Color(0.92, 0.78, 0.68, 1)
volumetric_fog_emission = Color(0.1, 0.06, 0.05, 1)
volumetric_fog_emission_energy = 0.2
volumetric_fog_gi_inject = 0.0
volumetric_fog_anisotropy = 0.6
volumetric_fog_length = 96.0
volumetric_fog_detail_spread = 2.0
volumetric_fog_ambient_inject = 0.25
volumetric_fog_sky_affect = 0.08
volumetric_fog_temporal_reprojection_enabled = true
volumetric_fog_temporal_reprojection_amount = 0.9
