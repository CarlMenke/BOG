[gd_resource type="Environment" load_steps=2 format=3 uid="uid://bq2gubrustenv"]

; Environment for Rust. Hot, dry, late afternoon — the opposite end of the day
; from `arena_env.tres`, which is Whisperbloom Hollow's torch-lit dusk (D-009).
;
; This file used to be *only* lighting, and said so: a two-colour
; `ProceduralSkyMaterial`, plain distance fog, no volumetrics, nothing at all in
; the air. That was an honest description of a map that read as a lighting test.
; What it is now is the light *and* the medium the light travels through, and
; the two are matched to each other on purpose.
;
;   * **The sky is `rust_sky.tres`**, a measured 2k CC0 HDR panorama with
;     drifting dust drawn over it. It is still the only source of ambient and of
;     reflections (`ambient_light_source`/`reflected_light_source` both the
;     sky), which is worth far more than it was: the panorama's lower hemisphere
;     is warm ochre rock, so the fill on every shaded face in the yard is the
;     real colour of light bouncing off dry ground rather than a guess at it.
;     That single change is why the numbers below moved the way they did.
;   * **`background_energy_multiplier` is still the exposure control here, not
;     `ambient_light_energy`.** With `ambient_light_source` set to SKY, Godot
;     4.7 takes ambient from the sky's radiance cubemap and *ignores*
;     `ambient_light_energy` and `ambient_light_sky_contribution` entirely —
;     measured on this map, not assumed: sweeping the energy from 1.0 to 2.0
;     produced byte-identical renders, and only switching the source off
;     changed anything. (Which also means `arena_env.tres`'s 2.5 does nothing.
;     Left alone; that is the island's file and its look is already signed off.)
;
;     So this is the number that matters, and it was re-measured when the sky
;     changed, because a photograph does not carry a procedural ramp's radiance
;     and the old 1.45 meant nothing against it. All eight spawn-pad views,
;     rendered 40 ticks in at 2560x1440, crushed being luma under 2/255, mud
;     under 12/255, clipped being any channel at 255:
;
;         0.75   crushed 0.309%   mud 2.50%   clipped 0.040%   p5  17   mean  88
;         0.90   crushed 0.091%   mud 1.29%   clipped 0.043%   p5  25   mean 102   <-
;         1.00   crushed 0.025%   mud 0.90%   clipped 0.046%   p5  30   mean 111
;         1.15   crushed 0.007%   mud 0.59%   clipped 0.052%   p5  37   mean 120
;
;     Nothing crushes anywhere on this curve, which is itself the finding: the
;     old sky left 9% of the frame black at 1.0 and this one leaves a tenth of a
;     percent at 0.90, because the ambient now comes off a real sunlit desert.
;     So the number is chosen at the *other* end — the point past which the yard
;     starts to flatten. Above about 1.15 the shaded side of a container and the
;     sunlit ground in front of it converge and the whole reason for dropping the
;     sun to 36 degrees is thrown away. 0.90 keeps a 25-to-191 range across the
;     eight views with a tenth of a percent crushed, which is contrast a hot
;     afternoon should have and shadow detail a player can still read a Bog in.
;   * ACES at white 6.0 and exposure 1.0, which is `arena_env.tres`'s
;     tonemapping unchanged — the two maps should not need different eyes.
;
; What is on, and why, since a map is allowed to differ here:
;
;   * **Glow, at low intensity.** Not a look choice: a thrown spear turns its
;     own material emissive so it can be seen coming (D-027), and with glow off
;     it simply is not. The threshold is 2.0 rather than the island's 1.45,
;     because everything here is already lit to about 1.0 by the sun and the
;     island's threshold would bloom the whole arena. It now also carries the
;     flare burning on the horizon and the two sodium lamps still alight in the
;     yard, which is the second reason to keep it.
;   * **SSAO, at about half the island's intensity.** It is what puts a barrel
;     on the ground rather than beside it. `ssao_light_affect` is 0 so it only
;     darkens the ambient — under a hard sun, letting AO bite into direct light
;     is most of what "murky" means.
;   * **Volumetric fog, which this file used to argue against.** The old
;     argument — that volumetrics buy the island its torch shafts at night and
;     buy nothing but a grey wash in daylight — was right about the wrong case.
;     The knob that changes the answer is `volumetric_fog_anisotropy`, and at
;     0.8 the scattering is strongly forward: the fog only brightens where you
;     are looking *into* the sun through it. So the gaps between the container
;     stacks throw real shafts on the side the light comes from and the rest of
;     the yard is left alone, which is the opposite of a wash. Density 0.011 is
;     about a third of what a mist wants, `volumetric_fog_sky_affect` is 0 so
;     the dome is never fogged twice, and `volumetric_fog_gi_inject` is 0
;     because there is no GI on this map to inject.
;   * **Distance fog, warmed and deepened.** 0.0035 against the old 0.0016,
;     because the map now has a horizon past its own walls — a tank farm at
;     118 m, a flare at 152, a cracking column at 168 and buttes out to 415 —
;     and with the old density they sat at the same contrast as the yard and
;     read as toys on a shelf. The readability arithmetic is the thing to check
;     rather than the look, and `1 - exp(-density * metres)` is all of it: at
;     20 m, where a Bog silhouette has to be recognisable, this is 6.8% fog; at
;     45 m, the longest sightline anywhere on the map, 14.5%; at 152 m, where
;     the flare stands, 41%. Nothing inside the yard is hidden and everything
;     outside it is softened. `fog_aerial_perspective` 0.6 makes the far stuff
;     take the sky's own colour instead of a flat grey, and `fog_sky_affect` is
;     0 so the sky keeps the haze `rust_sky.tres` paints into it rather than
;     getting a second one here.
;   * **No SDFGI**, as on the island, and for a better reason here: the geometry
;     never moves, and nothing in the frame budget is going spare.

[ext_resource type="Sky" path="res://resources/config/rust_sky.tres" id="1_rust_sky"]

[ext_resource type="Sky" path="res://resources/config/rust_sky.tres" id="1_rust_sky"]

[resource]
resource_name = "RustEnvironment"
background_mode = 2
sky = ExtResource("1_rust_sky")
background_energy_multiplier = 0.9
ambient_light_source = 3
reflected_light_source = 2
tonemap_mode = 3
tonemap_exposure = 1.0
tonemap_white = 6.0
ssao_enabled = true
ssao_radius = 1.1
ssao_intensity = 1.2
ssao_power = 1.4
ssao_detail = 0.6
ssao_horizon = 0.08
ssao_sharpness = 0.98
ssao_light_affect = 0.0
ssao_ao_channel_affect = 0.35
glow_enabled = true
glow_levels/1 = 0.0
glow_levels/2 = 0.35
glow_levels/3 = 0.85
glow_levels/4 = 1.0
glow_levels/5 = 0.7
glow_levels/6 = 0.25
glow_levels/7 = 0.0
glow_normalized = true
glow_intensity = 0.55
glow_strength = 1.0
glow_mix = 0.05
glow_bloom = 0.0
glow_blend_mode = 1
glow_hdr_threshold = 2.0
glow_hdr_scale = 2.0
glow_hdr_luminance_cap = 10.0
fog_enabled = true
fog_light_color = Color(0.79, 0.71, 0.57, 1)
fog_light_energy = 1.0
fog_sun_scatter = 0.2
fog_density = 0.0035
fog_aerial_perspective = 0.6
fog_sky_affect = 0.0
fog_height = 2.0
fog_height_density = 0.015
volumetric_fog_enabled = true
volumetric_fog_density = 0.011
volumetric_fog_albedo = Color(0.88, 0.82, 0.7, 1)
volumetric_fog_emission = Color(0, 0, 0, 1)
volumetric_fog_emission_energy = 0.0
volumetric_fog_anisotropy = 0.8
volumetric_fog_length = 96.0
volumetric_fog_detail_spread = 2.0
volumetric_fog_gi_inject = 0.0
volumetric_fog_ambient_inject = 0.12
volumetric_fog_sky_affect = 0.0
adjustment_enabled = true
adjustment_brightness = 1.0
adjustment_contrast = 1.04
