[gd_resource type="Environment" load_steps=3 format=3 uid="uid://cq2gubyachtenv"]

; Environment for Halcyon Wake. A clear Mediterranean morning at sea: the
; brightest, bluest map, and the far end of the palette from Lantern Wharf's
; dusk, Kopje Crossing's noon and the island's night (D-009, D-056, D-057).
;
; Derived from `wharf_env.tres`, and the rule held again: the tonemapping, glow
; and SSAO are the other maps', and the sky, fog and exposure are the difference.
;
;   * A clean sky, deep blue overhead and pale at the horizon. It is the ambient
;     and the reflections, so the white superstructure's shaded faces go a cool
;     blue and its lit faces stay warm white — that split is what lets one deck
;     be read against the one under it.
;   * The ground half of the sky is sea-coloured, so where the sea plane ends
;     under the fog the horizon does not show a seam.
;   * **`background_energy_multiplier` is the exposure control** (see
;     `rust_env.tres`). Set from renders; see D-057.
;   * Light fog tinted to the horizon, thin enough that the whole hull reads at
;     once and thick enough that the sea fades out before its edge.

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_yachtsky"]
sky_top_color = Color(0.18, 0.4, 0.78, 1)
sky_horizon_color = Color(0.7, 0.82, 0.92, 1)
sky_curve = 0.12
sky_energy_multiplier = 1.0
ground_bottom_color = Color(0.2, 0.36, 0.5, 1)
ground_horizon_color = Color(0.56, 0.7, 0.8, 1)
ground_curve = 0.04
ground_energy_multiplier = 1.0
sun_angle_max = 6.0
sun_curve = 0.1
use_debanding = true

[sub_resource type="Sky" id="Sky_yacht"]
sky_material = SubResource("ProceduralSkyMaterial_yachtsky")
radiance_size = 3

