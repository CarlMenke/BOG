[gd_scene load_steps=3 format=3 uid="uid://bgubmapquarry01"]

; Twin Quarry — the sixth map, and the first built for Capture B·O·G (D-058).
;
; Like Kopje Crossing, Lantern Wharf and Halcyon Wake this scene has no geometry
; in it at all. `scripts/world/maps/quarry_map.gd` extends `StaticMap` and builds
; the pit in `_ready()` from its layout tables — the floor, the rim cliff, the
; two cut benches with their walls, the two haul ramps into each, and the
; columns, blocks and kerbs standing in the middle, and the eight spoil rocks in
; the two empty corners — then calls `super()`, which sweeps all of it into
; world-space trimesh collision on layer 1, and then adds the dressing: rubble,
; weeds, puddles, ramp paint, two derricks over the rim and a work lamp over each
; base.
;
; The spoil rocks are on the solid side of that line and the rest of the kit is
; not, which is the point: a rock the size of a Bog reads as cover, so it is
; cover, and it is squashed to 1.2 m so it is a *kerb* rather than a fourth
; height nobody declared. A pebble or a weed is obviously not cover and is
; walked through.
;
; The symmetry is **rotational**: Team 2's half is Team 1's half turned 180
; degrees about the origin, so every coordinate below is one of a pair that
; negate each other. See the script's header for why that rather than a mirror.
;
; So this file is what `static_map.gd` asks for:
;
;   Environment  an overcast first light (`quarry_env.tres`) — the only grey
;                weather on the map list.
;   Sun          50 degrees up out of the north-east, pale and weak. Under a
;                flat sky it is barely a key light; SSAO and the drill lines cut
;                into the stone are what give the pit its shape. Serialised
;                ROW-major, as every `.tscn` stores a `Transform3D`.
;   Spawns       eight pads on the pit floor, four to a team, alternating so a
;                two-player match opens with the two players in opposite
;                corners. None of them is on a bench: you spawn *outside* your
;                base and run in, which is the same thing an attacker has to do
;                and is what keeps the ramps the busiest ground on the map.
;                Each faces the middle.
;   Bases        Team 1 at (-17.75, 4, -17.75), Team 2 at (17.75, 4, 17.75) —
;                the middle of each bench, four metres up, inside the wall
;                (D-051). 50.2 m apart, and neither can see the other: the
;                Stack stands on the diagonal between them.
;   Letters      G on the other diagonal, 28.5 m from each base; U and B a
;                rotational pair, 22.2 m from one and 32.5 m from the other
;                each way round. See the markers below for why they are not
;                three neutral points.
;
; `tools/preview_map.gd` stands a Bog on every pad, `tools/parkour_report.gd`
; walks the jump graph, proves the benches are reachable only by the ramps and
; that the columns and rim are reachable by nothing, and measures the longest
; sightline, and `tools/playthrough.gd` plans the capture layout off the
; declared bases — all four are in `tools/smoke_test.sh`.

[ext_resource type="Script" path="res://scripts/world/maps/quarry_map.gd" id="1_quarry_map"]
[ext_resource type="Environment" path="res://resources/config/quarry_env.tres" id="2_quarry_env"]

[node name="Quarry" type="Node3D"]
script = ExtResource("1_quarry_map")
void_height = -10.0
base_radius = 4.0

[node name="Environment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_quarry_env")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.81915, -0.43948, 0.36869, 0, 0.64279, 0.76604, -0.57358, -0.62757, 0.52654, 0, 40, 0)
light_color = Color(0.94, 0.95, 1, 1)
light_energy = 0.95
light_specular = 0.35
shadow_enabled = true
directional_shadow_mode = 1
directional_shadow_max_distance = 80.0
directional_shadow_blend_splits = true

[node name="Spawns" type="Node3D" parent="."]

; 0  Team 1, in the north band facing the middle
[node name="Spawn0" type="Marker3D" parent="Spawns"]
transform = Transform3D(-0.97946, 0, -0.20165, 0, 1, 0, 0.20165, 0, -0.97946, -3.5, 0.12, -17)

; 1  Team 2, its turn
[node name="Spawn1" type="Marker3D" parent="Spawns"]
transform = Transform3D(0.97946, 0, 0.20165, 0, 1, 0, -0.20165, 0, 0.97946, 3.5, 0.12, 17)

; 2  Team 1, the same spot on the west band
[node name="Spawn2" type="Marker3D" parent="Spawns"]
transform = Transform3D(-0.20165, 0, -0.97946, 0, 1, 0, 0.97946, 0, -0.20165, -17, 0.12, -3.5)

; 3  Team 2, its turn
[node name="Spawn3" type="Marker3D" parent="Spawns"]
transform = Transform3D(0.20165, 0, 0.97946, 0, 1, 0, -0.97946, 0, 0.20165, 17, 0.12, 3.5)

; 4  Team 1, out past the foot of the east ramp
[node name="Spawn4" type="Marker3D" parent="Spawns"]
transform = Transform3D(-0.97014, 0, 0.24254, 0, 1, 0, -0.24254, 0, -0.97014, 5, 0.12, -20)

; 5  Team 2, its turn
[node name="Spawn5" type="Marker3D" parent="Spawns"]
transform = Transform3D(0.97014, 0, -0.24254, 0, 1, 0, 0.24254, 0, 0.97014, -5, 0.12, 20)

; 6  Team 1, out past the foot of the south ramp
[node name="Spawn6" type="Marker3D" parent="Spawns"]
transform = Transform3D(0.17238, 0, -0.98503, 0, 1, 0, 0.98503, 0, 0.17238, -20, 0.12, 3.5)

; 7  Team 2, its turn
[node name="Spawn7" type="Marker3D" parent="Spawns"]
transform = Transform3D(-0.17238, 0, 0.98503, 0, 1, 0, -0.98503, 0, -0.17238, 20, 0.12, -3.5)

[node name="Bases" type="Node3D" parent="."]

; Team 1, the south-west bench
[node name="Team1" type="Marker3D" parent="Bases"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -17.75, 4, -17.75)

; Team 2, the north-east bench
[node name="Team2" type="Marker3D" parent="Bases"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 17.75, 4, 17.75)

[node name="Letters" type="Node3D" parent="."]

; G on the other diagonal — the perpendicular bisector of the line between the
; bases — which is the only place one card is exactly as far from one base as
; from the other. 28.5 m to each.
[node name="G" type="Marker3D" parent="Letters"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -9.5, 0, 9.5)

; U and B are a rotational pair rather than two more neutral points: each is
; near one team (22.2 m) and far from the other (32.5 m), and its partner is the
; other way round, so the pair is fair even though neither card is. There is
; nowhere left to put two neutral cards — the middle is the Stack.
[node name="U" type="Marker3D" parent="Letters"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 11.5, 0, -3.5)

[node name="B" type="Marker3D" parent="Letters"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -11.5, 0, 3.5)
