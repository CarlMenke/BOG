script = ExtResource("1_quarry_map")
void_height = -10.0
base_radius = 4.0

[node name="Environment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_quarry_env")

; Bright and white and shadowed, where the overcast's was pale and weak. The
; bearing is unchanged — the shadows were already falling the right way across
; the benches — but the energy is now a key light rather than a suggestion, and
; the shadow distance reaches the far rim so a base is in its own bench's shade.
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.81915, -0.43948, 0.36869, 0, 0.64279, 0.76604, -0.57358, -0.62757, 0.52654, 0, 40, 0)
light_color = Color(1, 0.97, 0.91, 1)
light_energy = 1.55
light_specular = 0.5
shadow_enabled = true
shadow_bias = 0.04
shadow_normal_bias = 1.4
directional_shadow_mode = 1
directional_shadow_max_distance = 110.0
directional_shadow_blend_splits = true

; The bounce. A quarry floor is pale limestone in direct sun, so the shaded side
; of everything in the pit is lit by a large warm source from below and in
; front — and a `ProceduralSkyMaterial` cannot supply that, because its ambient
; comes off a sky that is blue at the top and dusty white at the horizon. Left
; to it, every shadow on this map came out navy: the base benches read as the
; bottom of a swimming pool and the low terrace read as standing water.
;
; So this is Glowworm Grounds' trick (D-119): a second `DirectionalLight3D`,
; shadows **off**, on the bearing opposite the sun at a third of its energy, in
; the colour of the floor it is pretending to have come off. It points *down* at
; a shallow 22 degrees rather than up out of the ground, which was the first
; try: a light shining upward reaches only vertical faces and soffits, and the
; surfaces this map most needed rescuing were the shaded **floors** — a bench
; top, a terrace tread — every one of which faces the sky and got nothing at
; all from it. It is not physical and is not meant to be — it is one number
; standing in for a bounce solution nobody is going to run at sixty frames a
; second, and it is the difference between a sun-baked pit and a grey one with
; a bright side.
[node name="Bounce" type="DirectionalLight3D" parent="."]
position = Vector3(0, 12, 0)
rotation_degrees = Vector3(-22, 150, 0)
light_color = Color(1, 0.89, 0.72, 1)
light_energy = 0.46
light_specular = 0
shadow_enabled = false

