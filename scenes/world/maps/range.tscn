[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(-0.866025, -0.26496, 0.424024, 0, 0.848048, 0.529919, -0.5, 0.458924, -0.734431, 0, 40, 0)
light_color = Color(1, 0.91, 0.78, 1)
light_energy = 3.0
light_specular = 0.3
light_volumetric_fog_energy = 0.25
shadow_enabled = true
shadow_normal_bias = 1.6
directional_shadow_mode = 1
directional_shadow_max_distance = 120.0
directional_shadow_blend_splits = true

; The bounce, still load-bearing and now doing a third of the work it did. The
; key light reaches exactly two kinds of surface at any elevation: the tops of
; things and their north-north-east faces. Everything else on the map — every
; south face a shooter at a firing line is looking at, the underside of the
; lodge roof the eight pads stand under, the inside of the melee pit, the
; shaded half of every 1.25 m block — is lit by the sky ambient alone, and at
; nine degrees the first eye-height renders came back with eleven to sixteen per
; cent of the two back pads' frames at literal black. Kopje Crossing made the
; same argument for the same reason under a *noon* sun over pale sand (D-061)
; and the answer is the same one: a shadowless directional light almost
; anti-parallel to the Sun, warm, at a fraction of its energy.
;
; **0.15 rather than 0.45**, because the sky that feeds the ambient is now a lit
; day dome rather than a sunset and `range_env.tres`'s ambient went 0.62 to 1.15
; with it. A bounce sized against a night's fill is a second sun under a day's,
; and a second sun flattens the very silhouette the off-axis key is bought for.
; What it is still here for is the one surface the sky cannot reach: the
; underside of the lodge roof over the eight spawn pads.
;
; **`sky_mode = 1` (LIGHT_ONLY) is not optional.** `range_sky.gdshader` follows
; LIGHT0 for the sun disc and the glory (`sun_follow_light`), and a second light
; that reaches the sky can take LIGHT0 — the disc would jump to the
; south-south-west and disagree with every shadow on the map. D-061 records the
; same trap.
;
; It comes from the south-south-west at **-6 degrees**, which is to say from
; under the horizon behind you: bounce off ninety metres of wet peat arrives
; from below, and a light at +6 would be a second sun. 0.15 against the key's
; 3.0.
[node name="Bounce" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.8659, -0.05042, -0.4977, 0, 0.99492, -0.1008, 0.5002, 0.08728, 0.8615, 0, 30, 0)
light_color = Color(1, 0.78, 0.62, 1)
light_energy = 0.15
light_specular = 0.0
shadow_enabled = false
sky_mode = 1

[node name="Spawns" type="Node3D" parent="."]
