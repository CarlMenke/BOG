[gd_scene load_steps=3 format=3 uid="uid://bgubmapsafari1"]

; Kopje Crossing — the arena's third map, and the first hand-made one that is
; not an import (D-029, D-030, D-031).
;
; Rust is a bought `.glb` with a script wrapped round it; this scene has no
; geometry in it at all. `scripts/world/maps/safari_map.gd` extends `StaticMap`
; and *builds* the map in `_ready()` from a layout table — a hundred and
; twenty-three rock platforms, the plateau they stand on and the cliff it stands
; on — and then calls `super()`, which sweeps the lot into world-space trimesh
; collision on physics layer 1 exactly as it does for Rust. Trees, grass, bushes
; and the waterhole are added *after* that call, so none of them is collision;
; trees carry their own cylinder trunk colliders instead.
;
; So this file is the four nodes `static_map.gd` asks for, and nothing else:
;
;   Environment  a midday `WorldEnvironment`, because `arena.gd` builds none for
;                a static map and the island's is a torch-lit night (D-009).
;   Sun          64 degrees up and over the north-east, so every shadow on the
;                map falls the same way and the kopje's own shadow never covers
;                the spiral you are trying to climb. Serialised ROW-major, which
;                is how a `.tscn` stores a `Transform3D`.
;   Spawns       eight `Marker3D`s on a 44 m ring at bearings 22.5 + 45k, each
;                facing the middle. They are on flat open ground, out past the
;                city square where the platforms are, which is why — unlike
;                Rust's — they all sit at exactly 0.12 m, the island's
;                SPAWN_LIFT, and all read the same sightline.
;
; The map is the one thing here that is not stated but checked.
; `tools/preview_map.gd` stands a Bog-sized capsule on every pad and
; `tools/parkour_report.gd` rebuilds the whole jump graph out of the platform
; table and walks it from the ground, and `tools/smoke_test.sh` runs both as
; gates — so a gap nobody can cross fails a build rather than being discovered
; by somebody standing on a rock.

[ext_resource type="Script" path="res://scripts/world/maps/safari_map.gd" id="1_safari_map"]
[ext_resource type="Environment" path="res://resources/config/safari_env.tres" id="2_safari_env"]

[node name="Safari" type="Node3D"]
script = ExtResource("1_safari_map")
void_height = -14.0

[node name="Environment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_safari_env")

; High and hard, and the only light on the map. 64 degrees of elevation with the
; light travelling toward (-x, -z): high enough that the kopje does not lay a
; nine-metre shadow across the spiral, off-axis enough that every rock on the
; map has a lit face and a dark one to read its shape from. Two shadow splits
; out to 130 m, which is the diagonal of the plateau — the far rim has to cast,
; because the acacias around it are most of what gives the map a horizon.
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.70711, -0.63554, 0.30998, 0, 0.43837, 0.89879, -0.70711, -0.63554, 0.30998, 0, 30, 0)
light_color = Color(1, 0.96, 0.88, 1)
light_energy = 1.3
light_specular = 0.4
shadow_enabled = true
directional_shadow_mode = 1
directional_shadow_max_distance = 130.0
directional_shadow_blend_splits = true

; A second light, and the only one that is not the sun.
;
; Noon over 96 m of pale sand puts a great deal of light back up into the air,
; and the map had none of it: with one directional light the underside of every
; platform slab, the inside of every overhang and the shaded face of every rock
; fell to whatever the sky's lower hemisphere gave them, which in a render was
; a flat dead brown. That is a readability problem before it is a look one —
; the slabs a Bog lands on are read from below on the way up to them.
;
; So: a shadowless directional light pointing up and back — almost the exact
; anti-parallel of the Sun above, which is where a bounce off flat ground comes
; from — at 0.55 against the sun's 1.3, in the colour of the sand it is supposed
; to have come off. It costs no shadow map and no shadow pass, which is the
; whole reason it is a directional light and not four omnis under the kopje.
;
; 0.55 is measured, not chosen. The dark band of platform undersides across the
; top of the pad 0 render sat at (18, 12, 0) with one light; at 0.26 it came up
; to (26, 20, 3) and at 0.55 to (32, 26, 4), which is where it stops reading as
; a hole cut in the sky and starts reading as rock in shade. Pad 0 measures
; 0.00 % crushed and 0.41 % clipped, inside the budget `safari_env.tres` states.
;
; It stops at 0.55 rather than going further, and this is the note for the next
; person who looks at a pad render and reads those dark discs at eye level as
; unlit foliage. They are not foliage. They are the undersides of the landing
; slabs — `RockPath` meshes on their pillars — and the paving is visible in them
; at full resolution. Measured off the same pad 0 frame: the acacia canopy seen
; from below medians (145, 135, 56), a mid olive-gold, while the slab undersides
; median (37, 29, 5). The leaf cards are fine. Their normals average +0.59 in y
; and only one vertex in a hundred points down, so a canopy lights from the sun
; and reads from underneath; a backlight or a transmission term on them would
; wash out a canopy that is already working.
;
; The slabs stay dark on purpose. Sweeping this light to 0.85 and 1.20 moves
; them only to (38, 31, 5) and (45, 38, 6) — they are concave undersides and
; SSAO owns their ambient — while the sand goes 172 to 190 to 205 and undoes the
; palette `safari_map.gd` calibrated against the map as it shipped. That is a
; large cost for six points of grey. And on a parkour-first map the contrast is
; load-bearing the other way round: a dark slab underside against a bright sky
; is how a player standing on the ground sees that there is something up there
; to jump onto.
;
; `sky_mode = 1` is LIGHT_ONLY, and it is load-bearing: `safari_sky.gdshader`
; puts its sun disc on `LIGHT0`, and a second directional light that reached the
; sky shader could take that slot and move the sun into the ground.
[node name="Lights" type="Node3D" parent="."]

[node name="Bounce" type="DirectionalLight3D" parent="Lights"]
transform = Transform3D(-0.655, -0.6062, -0.4512, 0, 0.5971, -0.8022, 0.7556, -0.52544, -0.3911, 0, 6, 0)
light_color = Color(1, 0.88, 0.7, 1)
light_energy = 0.55
light_specular = 0.0
shadow_enabled = false
sky_mode = 1

