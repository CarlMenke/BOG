[gd_scene load_steps=3 format=3 uid="uid://bgubmapyacht01"]

; Halcyon Wake — the fifth map, a superyacht at anchor on a bright morning (D-057).
;
; Like Kopje Crossing and Lantern Wharf this scene has no geometry in it.
; `scripts/world/maps/yacht_map.gd` extends `StaticMap` and builds the yacht in
; `_ready()` from its layout tables — the hull, four decks, the deckhouses, the
; stairs and hop steps between them, the rails and the furniture — then calls
; `super()`, which sweeps them into world-space trimesh collision on layer 1,
; and then adds the dressing: the windows, the stair treads, the radar, the sea,
; the anchorage the yacht is lying in, the ensign and the cable, and the gulls.
; None of that is collision. The sea is the void.
;
; So this file is what `static_map.gd` asks for:
;
;   Environment  a clear Mediterranean morning (`yacht_env.tres`).
;   Sun          38 degrees up over the starboard bow, white-gold, shadowed, so
;                every deck casts a hard shadow on the one below it and the
;                stack reads as a stack. Serialised ROW-major, as every `.tscn`
;                stores a `Transform3D`. **That angle is a readability decision
;                and not a mood one**, and nothing in the atmosphere pass moves
;                it: `yacht_sky.tres` types the same direction for its sun disc
;                and `yacht_map.gd` hands the same one to the sea's shader, so
;                the disc, the shadows and the sun track on the water are one
;                number in three places rather than three opinions.
;   Lights       one more, and only one: `SeaBounce`, straight up, unshadowed,
;                which can only touch downward-facing surfaces. See its own
;                note below.
;   void_height  -3.5, half a metre under the sea's surface at -3.0. The lowest
;                floor on the map is the swim platform at -1.0.
;   Spawns       eight pads, four on the foredeck and four on the aft deck,
;                alternating bow and stern so a two-player match opens at
;                opposite ends. Each faces the middle of the yacht.
;   Bases        Team 1 on the foredeck in front of the tender, Team 2 on the
;                aft deck at the foot of the aft stairs, 43.5 m apart (D-051).
;   Letters      U and B in the open salon amidships, either side of the bar;
;                G two decks up, on the sun deck above them.
;
; `tools/preview_map.gd` stands a Gub on every pad, `tools/parkour_report.gd`
; walks the jump graph up all four decks, proves the mast is out of reach,
; measures the longest sightline and proves there is nothing but water over the
; side, and `tools/playthrough.gd` plans the capture layout off the declared
; bases — all four are in `tools/smoke_test.sh`.

[ext_resource type="Script" path="res://scripts/world/maps/yacht_map.gd" id="1_yacht_map"]
[ext_resource type="Environment" path="res://resources/config/yacht_env.tres" id="2_yacht_env"]

[node name="Yacht" type="Node3D"]
script = ExtResource("1_yacht_map")
void_height = -3.5
base_radius = 4.0

[node name="Environment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_yacht_env")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(-0.61217, -0.49044, 0.62025, 0, 0.78441, 0.62025, -0.79072, 0.3797, -0.48019, 0, 30, 0)
light_color = Color(1, 0.95, 0.86, 1)
light_energy = 1.2
light_specular = 0.8
shadow_enabled = true
directional_shadow_mode = 1
directional_shadow_max_distance = 90.0
directional_shadow_blend_splits = true

[node name="Lights" type="Node3D" parent="."]

; The sea, as a light. This is the cue the map was missing and the only one that
; says "on the water" rather than "outdoors": on a real yacht the undersides of
; every overhang — the upper deck over the main walkways, the sun deck over the
; balcony, the flybridge over the sun deck — are washed pale blue-green from
; below by a hundred square metres of sunlit sea, and nothing else in the world
; looks like that.
;
; A `DirectionalLight3D` pointing straight up, which lights **only** downward-
; facing surfaces: every top face on the map has a normal with no component
; along -Y, so this cannot touch a single deck, a single stair tread or a single
; Gub's hat, and the 38-degree sun's deck-on-deck shadow stack is untouched by
; construction rather than by taste. Shadows off, specular off, 0.18 energy.
; Cost is one more directional light and no shadow map.
[node name="SeaBounce" type="DirectionalLight3D" parent="Lights"]
transform = Transform3D(1, 0, 0, 0, 0, -1, 0, 1, 0, 0, -2, 0)
light_color = Color(0.52, 0.78, 0.86, 1)
light_energy = 0.18
light_specular = 0.0
shadow_enabled = false

